{
  "name": "@probeo/jsonld",
  "version": "0.2.2",
  "description": "Fast, zero-dependency JSON-LD validator. Validates schema.org structured data against Google rich results requirements.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "test": "npm run build && node --experimental-vm-modules node_modules/.bin/vitest run",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/vitest",
    "prepublishOnly": "npm run build",
    "vocabulary:update": "node scripts/update-schema-vocabulary.mjs",
    "validate:fixture": "npm run build --silent && node scripts/validate-fixture.mjs",
    "test:contract": "npm run build && node --experimental-vm-modules node_modules/.bin/vitest run tests/result-contract.test.ts",
    "test:fuzz": "npm run build && node scripts/fuzz.mjs"
  },
  "keywords": [
    "json-ld",
    "schema.org",
    "structured-data",
    "seo",
    "rich-results",
    "validation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/probeo-io/jsonld.git"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
